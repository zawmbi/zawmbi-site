---
/* Shut project page. The homepage card links here. Support (the App Store
   Support URL) is /shut/ and the privacy policy is /privacy/#shut. */
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import {
  shut,
  shutWalkthrough,
  shutFree,
  shutPro,
  shutProPrice,
  shutTechTags,
  shutTech,
} from '../../data/shut';
---

<Base
  title="Shut · a focus timer for iPhone · Zawmbi"
  description="Shut is a focus timer for iPhone with one input. Pick a length and lock your phone, and a block begins. Unlock early and the block breaks."
>
  <Nav />

  {/* ---------------- HERO ---------------- */}
  <section class="hero mon-hero" id="top">
    <div class="wrap">
      <a class="mon-back" href="/#apps">← Back to all apps</a>
      <div class="atz-hero-grid">
        <div>
          <div class="eyebrow" style="margin-top: 18px;">iPhone app</div>
          <h1 class="mon-title">{shut.name}</h1>
          <p class="mon-tag">{shut.tagline}</p>
          <p class="mon-blurb">{shut.blurb}</p>
          <p class="mon-blurb">There’s no blocklist to edit and no five-more-minutes button. The commitment is the lock.</p>
          <div class="mon-cta">
            {shut.appStore && (
              <a class="btn btn-solid btn-lg" href={shut.appStore} target="_blank" rel="noreferrer">Get it on the App Store ↗</a>
            )}
            <a class:list={['btn', 'btn-lg', shut.appStore ? 'btn-ghost' : 'btn-solid']} href={shut.support}>Support</a>
            <a class="btn btn-ghost btn-lg" href={shut.privacy}>Privacy</a>
          </div>
          <div class="mon-tags">
            {shutTechTags.map((t) => <span class="badge">{t}</span>)}
          </div>
        </div>
        <div class="atz-hero-shot">
          <div class="device-phone shut-phone">
            <ImageSlot
              src={shut.heroShot}
              alt="Shut timer screen: a ring counting down with 18:42 left."
              placeholder="Timer screen"
              style="width: 100%; height: 100%;"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- IPHONE DUO ---------------- */}
  <section class="section section-alt" id="duo">
    <div class="wrap">
      <div class="shut-duo pxc">
        <div class="eyebrow">iPhone Duo</div>
        <h2 class="hire-cta-title">Fold it shut. <span class="badge shut-coming">Coming in 1.1</span></h2>
        <p>
          Shut was built for iPhone Duo, Apple’s foldable. On Duo, folding the phone shut
          will be the trigger, and the timer will run on the outer display. That arrives in
          version 1.1.
        </p>
        <p>Version 1.0 is the lock version. It runs on every iPhone.</p>
      </div>
    </div>
  </section>

  {/* ---------------- WALKTHROUGH ---------------- */}
  <section class="section" id="walkthrough">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Walkthrough</div>
        <h2 class="sec-title">One block,<br />start to finish</h2>
      </div>
      <ol class="shut-walk">
        {shutWalkthrough.map((s, i) => (
          <li class="shut-step">
            <div class="device-phone shut-phone">
              <ImageSlot src={s.src} alt={s.alt} placeholder={s.title} style="width: 100%; height: 100%;" />
            </div>
            <div class="shut-step-text">
              <span class="shut-step-no">{String(i + 1).padStart(2, '0')}</span>
              <h3>{s.title}</h3>
              {s.note && <p>{s.note}</p>}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ---------------- FREE AND PRO ---------------- */}
  <section class="section section-alt" id="pricing">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Free and Pro</div>
        <h2 class="sec-title">Pay once,<br />or don’t</h2>
      </div>
      <div class="shut-tiers">
        <div class="shut-tier pxc">
          <h3 class="app-name">Free</h3>
          <div class="app-tag">Forever.</div>
          <ul class="site-points">
            {shutFree.map((p) => <li>{p}</li>)}
          </ul>
        </div>
        <div class="shut-tier shut-tier-pro pxc">
          <h3 class="app-name">Shut Pro · {shutProPrice}</h3>
          <div class="app-tag">One payment. No subscription. Everything in Free, plus:</div>
          <ul class="site-points">
            {shutPro.map((p) => <li>{p}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------- UNDER THE HOOD ---------------- */}
  <section class="section" id="build">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">Under the hood</div>
        <h2 class="sec-title">The stack</h2>
      </div>
      <div class="demo-list">
        {shutTech.map(([t, d]) => (
          <div class="demo-row">
            <h4>{t}</h4>
            <p>{d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ---------------- LINKS ---------------- */}
  <section class="section section-alt" id="links">
    <div class="wrap">
      <div class="hire-cta pxc">
        <div>
          <h2 class="hire-cta-title">Questions?</h2>
          <p class="hire-cta-sub">Support and the privacy policy each have their own page.</p>
        </div>
        <div class="shut-links">
          <a class="btn btn-solid btn-lg" href={shut.support}>Support →</a>
          <a class="btn btn-ghost btn-lg" href={shut.privacy}>Privacy →</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  /* The screenshots are 660 × 1434 (the 1320 × 2868 set, halved); match that
     exactly so nothing crops. */
  .shut-phone :global(.image-slot) { aspect-ratio: 660 / 1434 !important; }

  .shut-duo { background: var(--cream); border: var(--bd); box-shadow: var(--sh-lg); padding: 34px 38px; max-width: 860px; }
  .shut-duo .hire-cta-title { margin: 14px 0 0; display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .shut-duo p { font-size: 17px; line-height: 1.65; color: var(--dim); margin: 12px 0 0; max-width: 40em; text-wrap: pretty; }
  .shut-coming { background: var(--gold); }

  .shut-walk {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 24px;
  }
  .shut-step { display: flex; flex-direction: column; align-items: center; }
  .shut-step-text { width: 100%; max-width: 264px; margin-top: 18px; }
  .shut-step-no {
    font-family: var(--font-px); font-weight: 800; font-size: 12.5px; letter-spacing: .12em; color: var(--moss-deep);
  }
  .shut-step h3 {
    font-family: var(--font-display); font-weight: 800; font-size: 19px; color: var(--ink); margin: 4px 0 0;
  }
  .shut-step p { font-size: 15px; line-height: 1.55; color: var(--dim); margin: 6px 0 0; text-wrap: pretty; }

  .shut-tiers { display: grid; grid-template-columns: 1fr 1.25fr; gap: 20px; align-items: start; }
  .shut-tier { background: var(--cream); border: var(--bd); box-shadow: var(--sh); padding: 30px 32px; }
  .shut-tier-pro { box-shadow: var(--sh-lg); }
  .shut-tier .site-points { margin-top: 18px; }

  .shut-links { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 920px) {
    .shut-tiers { grid-template-columns: 1fr; }
    .shut-walk { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .shut-duo { padding: 26px 24px; }
    .shut-walk { gap: 34px 14px; }
    .shut-step h3 { font-size: 17px; }
  }
</style>
