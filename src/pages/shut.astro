---
/* Shut support page. This is the App Store Support URL, and Apple's reviewers
   open it: keep the one-line description, the contact email, the FAQ and the
   privacy link on it. The longer write-up lives on /projects/shut/. */
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { shut, shutFaq } from '../data/shut';
---

<Base
  title="Shut Support · Zawmbi"
  description="Support for Shut, a focus timer for iPhone: contact, FAQ and privacy policy."
>
  <Nav />

  <section class="hero mon-hero shut-sup-hero" id="top">
    <div class="wrap">
      <a class="mon-back" href={shut.project}>← About Shut</a>
      <div class="eyebrow" style="margin-top: 18px;">Support</div>
      <h1 class="mon-title">Shut</h1>
      <p class="mon-blurb">{shut.oneLine}</p>
      <div class="shut-contact pxc">
        <div>
          <h2 class="hire-cta-title">Contact</h2>
          <p class="hire-cta-sub">Email me. Say which iPhone you have and what happened.</p>
        </div>
        <a class="btn btn-solid btn-lg" href={`mailto:${shut.contact}`}>{shut.contact}</a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="support">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow">FAQ</div>
        <h2 class="sec-title">Questions</h2>
      </div>
      <div class="demo-list">
        {shutFaq.map(([q, a]) => (
          <div class="demo-row">
            <h3>{q}</h3>
            <p>{a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="privacy">
    <div class="wrap">
      <div class="hire-cta pxc">
        <div>
          <h2 class="hire-cta-title">Privacy</h2>
          <p class="hire-cta-sub">Shut does not collect any personal data.</p>
        </div>
        <a class="btn btn-solid btn-lg" href={shut.privacy}>Read the privacy policy →</a>
      </div>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .shut-sup-hero { padding-bottom: 56px; }
  .shut-contact {
    display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    background: var(--cream); border: var(--bd); box-shadow: var(--sh-lg);
    padding: 28px 32px; max-width: 860px; margin-top: 30px;
  }
  .shut-contact .hire-cta-title { margin: 0; }
  /* The FAQ uses h3s (the section title is the h2); match the demo-row h4 look. */
  #support .demo-row h3 {
    font-family: var(--font-display); font-weight: 800; font-size: 20px; margin: 0; color: var(--ink);
  }
  #support .demo-row p { font-size: 16.5px; color: var(--ink); }
  @media (max-width: 560px) {
    .shut-contact { padding: 24px 22px; }
  }
</style>
